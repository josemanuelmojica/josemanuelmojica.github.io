{
  // Cloudflare Workers configuration for Arχ & Teχt.
  //
  // The site is a static Next.js export (`output: "export"` -> ./out).
  // Cloudflare serves those files directly from the edge asset store.
  // The Worker script runs FIRST only for /api/* routes; every other
  // request (HTML, CSS, images, the state-art corpus) is served straight
  // from static assets without invoking the Worker.
  //
  // Lead records and durable rate-limit counters use the D1 binding below.
  // Turnstile and rate-limit secrets are configured in Cloudflare, never here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ark-and-text",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-11",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // The Worker only executes ahead of static assets for /api/* paths.
    // All other routes resolve directly to files in ./out.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "LEADS",
      "database_name": "ark-and-text-leads",
      "database_id": "16918945-5497-4884-8c32-91c603862ee2",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
