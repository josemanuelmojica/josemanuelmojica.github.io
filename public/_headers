# Cloudflare / browser cache rules.
#
# Only content-hashed, immutable media may be long-lived-cached: their URL
# changes whenever their bytes change, so a stale cache entry is impossible.
# Mutable files (HTML, the un-hashed masters) are intentionally NOT listed
# here and fall back to Cloudflare's default caching.

# Content-hashed responsive derivatives (generate-derivatives.mjs).
/derived/*
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed atlas tapestry variants (generate-atlas.mjs).
/derived/atlas/*
  Cache-Control: public, max-age=31536000, immutable
