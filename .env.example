# Leave empty for local development and Appwrite Sites.
# The GitHub Pages workflow supplies its repository base path automatically.
NEXT_PUBLIC_BASE_PATH=

# Canonical production origin used for social metadata.
# Example: https://guide.example.com
NEXT_PUBLIC_SITE_URL=

# Optional override for lead delivery. Leave blank on Cloudflare to use the
# same-origin /api/lead Worker route. GitHub Pages has no API and will retain
# the interview answers if submission fails.
NEXT_PUBLIC_SUBMIT_LEAD_URL=

# Optional public Turnstile site-key override. The repository's non-secret
# default lives in content/public-runtime-config.json.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
