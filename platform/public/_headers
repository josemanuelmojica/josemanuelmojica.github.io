# Cloudflare Pages response headers (applied at the edge).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://em.realscout.com; style-src 'self' 'unsafe-inline' https://em.realscout.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://em.realscout.com; img-src 'self' data: blob: https:; connect-src 'self' https://tiles.openfreemap.org https://*.realscout.com; worker-src 'self' blob:; child-src blob:; frame-src https://*.realscout.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://*.realscout.com

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
